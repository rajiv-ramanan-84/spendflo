# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL, used for the OAuth redirect
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Access. Bootstrap allowlist until the users table lands in milestone 2.
ALLOWED_EMAILS=rajiv@spendflo.com,siddharth@spendflo.com,chandramouli@spendflo.com,mahasweta@spendflo.com
ALLOWED_DOMAIN=spendflo.com

# Google (the same OAuth client is configured inside Supabase Auth > Google)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
TOKEN_ENCRYPTION_KEY=

# Claude
ANTHROPIC_API_KEY=

# Slack
SLACK_BOT_TOKEN=
