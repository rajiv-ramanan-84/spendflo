{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)outbound'",
  "git": {
    "deploymentEnabled": {
      "outbound-command-center": false,
      "claude/*": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-google-sheets",
      "schedule": "0 0 * * *"
    }
  ]
}
